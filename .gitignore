# Dependencies
node_modules/

# Build output — regenerated by `npm run build` / `npm run dev`
gloobal-essentials-preview/dist/

# Generated app entry — rebuilt from backend/ + frontend/ by build_app.mjs
# via the predev/prebuild hooks. Never edit or commit it; edit the source
# modules instead.
gloobal-essentials-preview/src/GloobalApp.jsx

# Generated test bundles — rebuilt by
# financial-principles-tests/scripts/build-test-bundle.mjs.
# Note: the test files import these directly, so they must exist on disk
# to run the suite. Regenerate with:
#   cd financial-principles-tests && node scripts/build-test-bundle.mjs
financial-principles-tests/app_bundle_testonly.mjs
financial-principles-tests/src/data/essentialsBaseline.js

# Local env overrides (.env.example is committed, real values are not)
.env
.env.local
.env.*.local

# Scratch
_trash/
*.log

# Raw AI-session transcript kept for local reference only. Not project
# documentation, and it embeds absolute Windows home-directory paths —
# this repo is public, so it stays out of it. The file remains on disk.
memory.txt

# Netlify CLI/MCP deploy state — machine-local, never committed.
.netlify/

server/node_modules/
server/.env
# Any throwaway server env (e.g. .env.browsercheck, written by the browser
# verification run) — these carry a real Atlas connection string with
# credentials in it, differing from server/.env only in the database name.
server/.env.*
!server/.env.example

# --- Developer tooling (tools/) ---
# Both mailers read their credentials at run time. The *.example files are
# committed; the real ones never are.
tools/email/secret.txt
tools/email/report-mailer/.env
tools/email/report-mailer/node_modules/
tools/email/__pycache__/
# Generated report output, written next to the Python mailer when it runs.
tools/email/report.md
tools/email/report.html
tools/email/progress-report.txt

# Screenshot written by tools/frontend/verify-coverage-ui.mjs on each run.
tools/frontend/verify-coverage-ui.png
