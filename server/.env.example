PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gloobal_db?retryWrites=true&w=majority

# Signing key for the bearer tokens every authenticated route checks
# (see resolveAuthTokenSecret in server.js). REQUIRED in production — the
# server refuses to start without it, because signing with a key generated
# at boot invalidates every issued token on every restart, and on Render's
# free tier the service restarts whenever it has been idle. That is what
# made already-signed-in people see "Sign in to continue".
#
# Must be stable for the life of the deployment: changing it signs everyone
# out once, exactly as a restart used to. At least 32 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# NEVER commit the real value. In production it lives only in the Render
# service's Environment settings.
AUTH_TOKEN_SECRET=

PROTOTYPE_OTP=123456
# The per-transaction ceiling, in the SENDER's own currency. Also read by
# the Coin and GEU routes for their own per-operation caps.
PROTOTYPE_TRANSACTION_MAX_AMOUNT=5000000
# Comma-separated browser origins allowed to call this API. Leave unset to
# fall back to the live frontend plus the local dev ports, which is exactly
# what server.js defaults to:
#   https://gloobalv3.netlify.app,http://localhost:5173,http://127.0.0.1:5173
#
# Only set this to override that default. Setting it to anything that omits
# https://gloobalv3.netlify.app blocks the live frontend from calling the API
# — the browser reports a CORS failure that reads exactly like the backend
# being down.
# ALLOWED_ORIGINS=https://gloobalv3.netlify.app,http://localhost:5173
