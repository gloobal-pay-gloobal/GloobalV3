PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gloobal_db?retryWrites=true&w=majority

# Signing key for the bearer tokens every authenticated route checks
# (see resolveAuthTokenSecret in server.js). REQUIRED in production — the
# server refuses to start without it, because signing with a key generated
# at boot invalidates every issued token on every restart, and on Render's
# free tier the service restarts whenever it has been idle. That is what
# made already-signed-in people see "Sign in to continue".
#
# Must be stable for the life of the deployment: changing it signs everyone
# out once, exactly as a restart used to. At least 32 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# NEVER commit the real value. In production it lives only in the Render
# service's Environment settings.
AUTH_TOKEN_SECRET=

PROTOTYPE_OTP=123456
# The per-transaction ceiling, in the SENDER's own currency. Also read by
# the Coin and GEU routes for their own per-operation caps.
PROTOTYPE_TRANSACTION_MAX_AMOUNT=5000000
# Comma-separated browser origins allowed to call this API. Leave unset to
# fall back to the live frontend plus the local dev ports, which is exactly
# what server.js defaults to:
#   https://gloobalv3.netlify.app,http://localhost:5173,http://127.0.0.1:5173
#
# Only set this to override that default. Setting it to anything that omits
# https://gloobalv3.netlify.app blocks the live frontend from calling the API
# — the browser reports a CORS failure that reads exactly like the backend
# being down.
# ALLOWED_ORIGINS=https://gloobalv3.netlify.app,http://localhost:5173

# ─── Web Push ───────────────────────────────────────────────────────────────
#
# VAPID keys identify this server to the browser push services (FCM, Mozilla,
# Windows). Generate a pair once and keep it for the life of the deployment:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# Changing the pair invalidates every subscription already stored — every
# device silently stops receiving, and the push services answer 401/403 rather
# than 410, so the rows are not even cleaned up. Treat it as permanent.
#
# UNLIKE AUTH_TOKEN_SECRET, these are optional. With either one missing, push
# is simply disabled: notifications are still written to the database and the
# /api/push/* routes answer 503 push_disabled. The server still boots — a
# payments API must not refuse to start over a notification setting.
#
# NEVER commit the real private key. In production both live only in the
# Render service's Environment settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The "who to contact about this push" address the push services require.
# Defaults to mailto:gloobalpay@gmail.com when unset.
VAPID_SUBJECT=mailto:gloobalpay@gmail.com

# Shared secret for POST /api/push/promotional, the marketing broadcast. It is
# not a user route — there is no signed-in account behind it — so it is gated
# by this token in an x-push-admin-token header instead, compared in constant
# time. Leave it UNSET unless a broadcast is actually being run: with no value
# the route does not exist at all (404), which is the safer default.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PUSH_ADMIN_TOKEN=
